{
  "name": "@open-agent-teams/core",
  "version": "0.1.0",
  "description": "Open-Agent-Teams shared core — 多 Agent 编排框架",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime/admission": {
      "import": "./dist/runtime/RuntimeAdmissionController.js",
      "types": "./dist/runtime/RuntimeAdmissionController.d.ts"
    },
    "./runtime/resilience": {
      "import": "./dist/runtime/ResilientCallExecutor.js",
      "types": "./dist/runtime/ResilientCallExecutor.d.ts"
    },
    "./runtime/lifecycle": {
      "import": "./dist/runtime/RuntimeLifecycle.js",
      "types": "./dist/runtime/RuntimeLifecycle.d.ts"
    },
    "./team-management": {
      "import": "./dist/team-management/index.js",
      "types": "./dist/team-management/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@open-multi-agent/core": "1.4.2",
    "better-sqlite3": "^11.0.0",
    "express": "^4.18.0",
    "uuid": "^9.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.3.0"
  }
}
